    <string name="summary_watch">Beidh cead ag an aip seo faisnéis a shioncronú, amhail ainm duine atá ag glaoch, agus na ceadanna seo a rochtain ar do &lt;xliff:g id="device_type" example="phone"&gt;%1$s&lt;/xliff:g&gt;%1$s&lt;/xliff:g&gt;</string>
    <string name="summary_glasses">Beidh cead ag an aip seo na ceadanna seo a rochtain ar do <xliff:g id="device_type" example="phone">%1$s</xliff:g></string>
    <string name="summary_app_streaming_legacy">Beidh rochtain ag <xliff:g id="app_name" example="Exo">%1$s</xliff:g> ar aon rud atá infheicthe nó seinnte ar do <xliff:g id="device_type" example="phone">%2$s</xliff:g>, lena n-áirítear fuaime, grianghraif, faisnéis íocaíochta, pasfhocail agus teachtaireachtaí<xliff:g id="app_name" example="Exo">%1$s</xliff:g> in ann aipeanna a shruthú go <xliff:g id="device_name" example="Chromebook">%3$s</xliff:g> go dtí go mbainfidh tú rochtain ar an gcead seo.</string>
    <string name="helper_summary_computer"><xliff:g id="app_name" example="GMS">%1$s</xliff:g> ag iarraidh cead thar ceann do <xliff:g id="device_name" example="Chromebook">%2$s</xliff:g> chun rochtain a fháil ar ghrianghraif, meáin, agus fógraí do <xliff:g id="device_type" example="phone">%3$s</xliff:g></string>
    <string name="summary_nearby_device_streaming_legacy">Beidh rochtain ag <xliff:g id="app_name" example="Exo">%1$s</xliff:g> ar aon rud atá infheicthe nó seinnte ar <xliff:g id="device_name" example="Chromebook">%3$s</xliff:g>, lena n-áirítear fuaim, grianghraif, faisnéis íocaíochta, pasfhocail agus teachtaireachtaí.<xliff:g id="app_name" example="Exo">%1$s</xliff:g>in ann aipeanna a shruthú go <xliff:g id="device_name" example="Chromebook">%3$s</xliff:g> go dtí go mbainfidh tú rochtain ar an gcead seo.</string>
